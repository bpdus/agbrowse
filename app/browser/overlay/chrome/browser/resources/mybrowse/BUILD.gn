import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "mybrowse"

  static_files = [
    "mybrowse.html",
    "style.css",
  ]

  ts_files = [
    "app.ts",
    "bridge.ts",
    "selection.ts",
  ]

  ts_composite = true
  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  webui_context_type = "trusted"

  mojo_files_deps =
      [ "//chrome/browser/ui/webui/mybrowse:mojo_bindings_ts__generator" ]
  mojo_files = [
    "$root_gen_dir/chrome/browser/ui/webui/mybrowse/mybrowse.mojom-webui.ts",
  ]
}
